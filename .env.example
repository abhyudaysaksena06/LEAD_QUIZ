# Copy to .env and fill in from Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Optional: "Continue with Google" (Firebase Auth) ----------------------
# Firebase Console -> Project settings -> Your apps -> Web app. Leave blank to hide the button.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Server-only (Vercel env vars, never VITE_*) ---------------------------
# ANTHROPIC_API_KEY=        AI judge (api/judge.js)
# SCREENING_SERVER_SECRET=  shared with the database for Google sign-in (api/google-login.js);
#                           its SHA-256 goes in quiz.screening_config.federation_secret_hash

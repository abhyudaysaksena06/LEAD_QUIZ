# Copy to .env and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Optional: Google sign-in via Firebase -------------------------------
# Leave blank to use roll number + password only (the Google button is hidden).
# Values come from Firebase Console → Project settings → Your apps → Web app.
# Supabase must also be told to trust this Firebase project:
#   Supabase → Authentication → Third-Party Auth → Add Firebase → paste the project ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
